diff --git 1/packages/tui/test/overlay-image-layering.test.ts 2/packages/tui/test/overlay-image-layering.test.ts
new file mode 100644
index 0000000..5799a94
--- /dev/null
+++ 2/packages/tui/test/overlay-image-layering.test.ts
@@ -0,0 +1,84 @@
+import assert from "node:assert";
+import { describe, it } from "node:test";
+import type { Component } from "../src/tui.ts";
+import { TUI } from "../src/tui.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+type OverlayComposite = {
+	compositeOverlays(lines: string[], termWidth: number, termHeight: number): string[];
+};
+
+class StaticOverlay implements Component {
+	private readonly lines: string[];
+	constructor(lines: string[]) {
+		this.lines = lines;
+	}
+	render(): string[] {
+		return this.lines;
+	}
+	invalidate(): void {}
+}
+
+const kittyImage = "\x1b_Ga=T,f=100,q=2,C=1,c=20,r=3,i=42;payload\x1b\\";
+
+function compositor(tui: TUI): OverlayComposite {
+	return tui as unknown as OverlayComposite;
+}
+
+describe("overlay image layering", () => {
+	it("suppresses a lower Kitty image when a modal intersects its reserved rows", () => {
+		const tui = new TUI(new VirtualTerminal(40, 10));
+		const base = Array.from({ length: 10 }, () => "");
+		base[3] = kittyImage;
+		tui.showOverlay(new StaticOverlay(["MODAL"]), { row: 4, col: 5, width: 10 });
+
+		const result = compositor(tui).compositeOverlays(base, 40, 10);
+
+		assert.equal(
+			result.some((line) => line.includes("\x1b_G")),
+			false,
+		);
+		assert.equal(result[4]?.includes("MODAL"), true);
+	});
+
+	it("suppresses a decorated Kitty image when a modal intersects a lower image row", () => {
+		const tui = new TUI(new VirtualTerminal(40, 10));
+		const base = Array.from({ length: 10 }, () => "");
+		base[3] = `│${kittyImage}${" ".repeat(18)}│`;
+		base[4] = `│${" ".repeat(38)}│`;
+		base[5] = `│${" ".repeat(38)}│`;
+		tui.showOverlay(new StaticOverlay(["MODAL"]), { row: 5, col: 5, width: 10 });
+
+		const result = compositor(tui).compositeOverlays(base, 40, 10);
+
+		assert.equal(
+			result.some((line) => line.includes("\x1b_G")),
+			false,
+		);
+		assert.equal(result[5]?.includes("MODAL"), true);
+	});
+
+	it("keeps a lower Kitty image when the overlay does not intersect its rows", () => {
+		const tui = new TUI(new VirtualTerminal(40, 10));
+		const base = Array.from({ length: 10 }, () => "");
+		base[6] = kittyImage;
+		tui.showOverlay(new StaticOverlay(["MODAL"]), { row: 1, col: 5, width: 10 });
+
+		const result = compositor(tui).compositeOverlays(base, 40, 10);
+
+		assert.equal(result[6]?.includes("\x1b_G"), true);
+		assert.equal(result[1]?.includes("MODAL"), true);
+	});
+
+	it("keeps a lower Kitty image when only its rows intersect", () => {
+		const tui = new TUI(new VirtualTerminal(40, 10));
+		const base = Array.from({ length: 10 }, () => "");
+		base[3] = `${" ".repeat(20)}${kittyImage}`;
+		tui.showOverlay(new StaticOverlay(["MODAL"]), { row: 4, col: 2, width: 10 });
+
+		const result = compositor(tui).compositeOverlays(base, 40, 10);
+
+		assert.equal(result[3]?.includes("\x1b_G"), true);
+		assert.equal(result[4]?.includes("MODAL"), true);
+	});
+});
